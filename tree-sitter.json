{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "c-sharp",
      "camelcase": "CSharp",
      "scope": "source.cs",
      "path": ".",
      "file-types": ["cs"],
      "highlights": ["queries/highlights.scm"],
      "tags": ["queries/tags.scm"],
      "injection-regex": "cs"
    }
  ],
  "metadata": {
    "version": "0.23.5",
    "license": "MIT",
    "description": "C# grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-c-sharp"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
