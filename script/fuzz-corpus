#!/usr/bin/env bash

# Runs `tree-sitter fuzz`: it edits each corpus case at random, reparses it incrementally, undoes the edits, and
# reparses again, on the runtime that script/tree-sitter runs.

set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p .tmp/fuzz
parser=$(mktemp .tmp/fuzz/c_sharp.XXXXXX)
trap 'rm -f "$parser"' EXIT
script/tree-sitter build -o "$parser"
script/tree-sitter fuzz --lib-path "$parser" --lang-name c_sharp
